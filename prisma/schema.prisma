// Mavericks Inventory — data model
// PostgreSQL works on Vercel (Neon/Vercel Postgres), AWS (RDS/Aurora) and Azure (Database for PostgreSQL).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  EXECUTIVE
  MANAGER
  AUTHORITY
  ADMIN
  EMPLOYEE // portal access only: own points, goodies and events
}

enum ItemStatus {
  DRAFT // created/uploaded, not yet approved — no stock impact
  ACTIVE // approved, available for transactions
  INACTIVE // logically deleted
}

enum RequestType {
  STOCK_MASTER // new stock items + opening quantity
  RECEIPT // stock inward (replenishment of an existing item)
  DISTRIBUTION // stock outward to recipients
  STOCK_COUNT // physical count; approved variances adjust stock
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalAction {
  SUBMITTED
  APPROVED
  REJECTED
  RESUBMITTED
  CANCELLED
}

enum LedgerType {
  OPENING
  RECEIPT
  DISTRIBUTION
  ADJUSTMENT
}

model User {
  id           String    @id @default(cuid())
  empId        String    @unique
  name         String
  email        String    @unique
  passwordHash String
  role         Role
  department   String?
  location     String?
  active       Boolean   @default(true)
  mustChangePw Boolean   @default(false)
  lastLoginAt  DateTime?
  /// Set when the person signs in with company SSO: "<issuer>|<subject>" from the identity provider.
  ssoSubject   String?   @unique
  /// Portal users (role EMPLOYEE) are linked to their employee record.
  employeeId   String?   @unique
  employee     Employee? @relation(fields: [employeeId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  requests     Request[]       @relation("RequestCreator")
  approvals    ApprovalEvent[]
  itemsCreated StockItem[]     @relation("ItemCreator")
  ledger       LedgerEntry[]
  audits       AuditLog[]
  uploads      UploadBatch[]
}

model Category {
  id        String      @id @default(cuid())
  name      String      @unique
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  items     StockItem[]
}

/// Generic lookup lists managed by admins: locations, distribution purposes, units.
model Lookup {
  id        String   @id @default(cuid())
  kind      String // LOCATION | PURPOSE | UNIT
  value     String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([kind, value])
}

model StockItem {
  id             String     @id @default(cuid())
  code           String     @unique
  name           String // "Product Details" in the legacy tracker, e.g. "Mavericks T-Shirt - L - Ash - Crocodile"
  product        String // e.g. "Mavericks T-Shirt"
  categoryId     String
  category       Category   @relation(fields: [categoryId], references: [id])
  size           String?
  color          String?
  brand          String?
  unit           String     @default("Nos")
  location       String?
  unitCost       Decimal?   @db.Decimal(12, 2)
  reorderLevel   Int        @default(0)
  openingQty     Int        @default(0)
  // Running balances. Only changed inside approval transactions (see lib/workflow.ts).
  receivedQty    Int        @default(0)
  distributedQty Int        @default(0)
  adjustedQty    Int        @default(0) // net change from approved stock counts
  availableQty   Int        @default(0)
  status         ItemStatus @default(DRAFT)
  deletedAt      DateTime?
  createdById    String
  createdBy      User       @relation("ItemCreator", fields: [createdById], references: [id])
  requestId      String? // the STOCK_MASTER request that introduced this item
  request        Request?   @relation("MasterItems", fields: [requestId], references: [id])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  receiptLines      ReceiptLine[]
  distributionLines DistributionLine[]
  countLines        StockCountLine[]
  ledger            LedgerEntry[]
  milestones        RewardMilestone[]

  @@index([status])
  @@index([product])
}

model Request {
  id            String        @id @default(cuid())
  number        String        @unique // MI-DST-2026-000123
  type          RequestType
  status        RequestStatus @default(DRAFT)
  title         String
  purpose       String?
  remarks       String?
  currentLevel  Int           @default(0) // levels already approved
  requiredLevel Int           @default(1) // snapshot of the configured levels at submission
  createdById   String
  createdBy     User          @relation("RequestCreator", fields: [createdById], references: [id])
  submittedAt   DateTime?
  decidedAt     DateTime?
  totalQty      Int           @default(0)
  lineCount     Int           @default(0)
  uploadBatchId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  masterItems       StockItem[]        @relation("MasterItems")
  receiptLines      ReceiptLine[]
  distributionLines DistributionLine[]
  countLines        StockCountLine[]
  events            ApprovalEvent[]
  ledger            LedgerEntry[]

  @@index([status, type])
  @@index([createdById])
  @@index([createdAt])
}

model DistributionLine {
  id            String        @id @default(cuid())
  requestId     String
  request       Request       @relation(fields: [requestId], references: [id], onDelete: Restrict)
  stockItemId   String
  stockItem     StockItem     @relation(fields: [stockItemId], references: [id])
  quantity      Int
  distributedOn DateTime
  recipientId   String? // employee id
  recipientName String
  location      String?
  purpose       String? // Onboarding, Event - Design-a-thon, Mavericks Week, ...
  poc           String?
  remarks       String?
  /// Set when this handover fulfils a points milestone reward.
  rewardId      String?       @unique
  reward        RewardEarned? @relation(fields: [rewardId], references: [id])
  createdAt     DateTime      @default(now())

  @@index([stockItemId])
  @@index([requestId])
  @@index([recipientId])
  @@index([distributedOn])
}

/// One counted item in a physical stock count (cycle count). The approved variance adjusts stock.
model StockCountLine {
  id          String    @id @default(cuid())
  requestId   String
  request     Request   @relation(fields: [requestId], references: [id], onDelete: Restrict)
  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id])
  systemQty   Int // available quantity when the count was recorded
  countedQty  Int
  reason      String?
  createdAt   DateTime  @default(now())

  @@unique([requestId, stockItemId])
  @@index([stockItemId])
}

model ReceiptLine {
  id          String    @id @default(cuid())
  requestId   String
  request     Request   @relation(fields: [requestId], references: [id], onDelete: Restrict)
  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id])
  quantity    Int
  receivedOn  DateTime
  remarks     String?
  createdAt   DateTime  @default(now())

  @@index([stockItemId])
}

/// Immutable approval history — rows are only ever inserted.
model ApprovalEvent {
  id        String         @id @default(cuid())
  requestId String
  request   Request        @relation(fields: [requestId], references: [id])
  action    ApprovalAction
  level     Int            @default(0)
  actorId   String
  actor     User           @relation(fields: [actorId], references: [id])
  remarks   String?
  createdAt DateTime       @default(now())

  @@index([requestId])
}

/// Stock movement ledger — rows are only ever inserted.
model LedgerEntry {
  id           String     @id @default(cuid())
  stockItemId  String
  stockItem    StockItem  @relation(fields: [stockItemId], references: [id])
  requestId    String?
  request      Request?   @relation(fields: [requestId], references: [id])
  type         LedgerType
  qtyIn        Int        @default(0)
  qtyOut       Int        @default(0)
  balanceAfter Int
  note         String?
  actorId      String
  actor        User       @relation(fields: [actorId], references: [id])
  createdAt    DateTime   @default(now())

  @@index([stockItemId, createdAt])
  @@index([createdAt])
}

/// Data change log for every write in the system.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String // e.g. STOCK_ITEM.UPDATE
  entity    String
  entityId  String?
  summary   String
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model UploadBatch {
  id        String   @id @default(cuid())
  kind      String // STOCK_MASTER | DISTRIBUTION | RECEIPT
  fileName  String
  totalRows Int
  validRows Int
  errorRows Int
  errors    Json? // [{row, field, message}]
  createdBy String
  user      User     @relation(fields: [createdBy], references: [id])
  createdAt DateTime @default(now())
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model Counter {
  key   String @id
  value Int    @default(0)
}

// ---------------------------------------------------------------------------
// Engagement rewards: employees earn points for attending events; every
// `step` points (default 2,000) up to `cap` (default 20,000) unlocks a goodie.
// ---------------------------------------------------------------------------

model Employee {
  id             String   @id @default(cuid())
  empId          String   @unique
  name           String
  email          String?  @unique
  department     String?
  designation    String?
  location       String?
  active         Boolean  @default(true)
  /// Current points in this cycle (0..cap). Kept in step with PointsTransaction inside transactions.
  points         Int      @default(0)
  /// All points ever credited, across resets.
  lifetimePoints Int      @default(0)
  /// Increases on each reset, so milestones can be earned again in a new cycle.
  cycle          Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User?
  attendance   Attendance[]
  transactions PointsTransaction[]
  rewards      RewardEarned[]

  @@index([points])
  @@index([name])
}

enum EventCategory {
  TECH
  NON_TECH
  WORKSHOP
  HACKATHON
  CODEATHON
  OTHER
}

/// Admin-maintained point values. Changing points affects future attendance only.
model EventType {
  id          String        @id @default(cuid())
  name        String        @unique
  category    EventCategory
  points      Int
  description String?
  active      Boolean       @default(true)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  events      Event[]
}

enum EventStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

model Event {
  id           String              @id @default(cuid())
  code         String              @unique // EV-2026-0012
  name         String
  eventTypeId  String
  eventType    EventType           @relation(fields: [eventTypeId], references: [id])
  /// Optional per-event override of the type's points (e.g. a flagship hackathon).
  points       Int?
  date         DateTime
  location     String?
  organizer    String?
  description  String?
  status       EventStatus         @default(PLANNED)
  createdById  String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  attendance   Attendance[]
  transactions PointsTransaction[]

  @@index([date])
}

model Attendance {
  id            String   @id @default(cuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  pointsAwarded Int
  createdById   String
  createdAt     DateTime @default(now())

  @@unique([eventId, employeeId])
  @@index([employeeId])
}

enum PointsType {
  EVENT
  ADJUSTMENT
  RESET
  REVERSAL
}

/// Points ledger — rows are only ever inserted.
model PointsTransaction {
  id           String     @id @default(cuid())
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id])
  type         PointsType
  points       Int // signed change actually applied (after the cap)
  requested    Int // what was asked for (differs from `points` when the cap applied)
  balanceAfter Int
  cycle        Int
  eventId      String?
  event        Event?     @relation(fields: [eventId], references: [id])
  reason       String?
  actorId      String
  createdAt    DateTime   @default(now())

  @@index([employeeId, createdAt])
}

/// What each milestone (2,000, 4,000 … 20,000) gives. The goodie can be decided later.
model RewardMilestone {
  id          String     @id @default(cuid())
  threshold   Int        @unique
  title       String
  description String?
  stockItemId String?
  stockItem   StockItem? @relation(fields: [stockItemId], references: [id])
  quantity    Int        @default(1)
  active      Boolean    @default(true)
  updatedAt   DateTime   @updatedAt
}

enum RewardStatus {
  DUE // milestone reached, goodie not yet handed over
  IN_PROGRESS // on a distribution request waiting for approval
  ISSUED // distribution approved, stock deducted
  CANCELLED
}

model RewardEarned {
  id         String            @id @default(cuid())
  employeeId String
  employee   Employee          @relation(fields: [employeeId], references: [id])
  threshold  Int
  cycle      Int
  title      String // copy of the milestone title when earned
  status     RewardStatus      @default(DUE)
  earnedAt   DateTime          @default(now())
  issuedAt   DateTime?
  requestId  String? // distribution request carrying it
  note       String?
  line       DistributionLine?

  @@unique([employeeId, threshold, cycle])
  @@index([status])
}
