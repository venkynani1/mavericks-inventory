// Mavericks Inventory — data model
// PostgreSQL works on Vercel (Neon/Vercel Postgres), AWS (RDS/Aurora) and Azure (Database for PostgreSQL).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  EXECUTIVE
  MANAGER
  AUTHORITY
  ADMIN
}

enum ItemStatus {
  DRAFT // created/uploaded, not yet approved — no stock impact
  ACTIVE // approved, available for transactions
  INACTIVE // logically deleted
}

enum RequestType {
  STOCK_MASTER // new stock items + opening quantity
  RECEIPT // stock inward (replenishment of an existing item)
  DISTRIBUTION // stock outward to recipients
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalAction {
  SUBMITTED
  APPROVED
  REJECTED
  RESUBMITTED
  CANCELLED
}

enum LedgerType {
  OPENING
  RECEIPT
  DISTRIBUTION
  ADJUSTMENT
}

model User {
  id           String   @id @default(cuid())
  empId        String   @unique
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  department   String?
  location     String?
  active       Boolean  @default(true)
  mustChangePw Boolean  @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requests     Request[]       @relation("RequestCreator")
  approvals    ApprovalEvent[]
  itemsCreated StockItem[]     @relation("ItemCreator")
  ledger       LedgerEntry[]
  audits       AuditLog[]
  uploads      UploadBatch[]
}

model Category {
  id        String      @id @default(cuid())
  name      String      @unique
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  items     StockItem[]
}

/// Generic lookup lists managed by admins: locations, distribution purposes, units.
model Lookup {
  id        String   @id @default(cuid())
  kind      String // LOCATION | PURPOSE | UNIT
  value     String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([kind, value])
}

model StockItem {
  id             String     @id @default(cuid())
  code           String     @unique
  name           String // "Product Details" in the legacy tracker, e.g. "Mavericks T-Shirt - L - Ash - Crocodile"
  product        String // e.g. "Mavericks T-Shirt"
  categoryId     String
  category       Category   @relation(fields: [categoryId], references: [id])
  size           String?
  color          String?
  brand          String?
  unit           String     @default("Nos")
  location       String?
  unitCost       Decimal?   @db.Decimal(12, 2)
  reorderLevel   Int        @default(0)
  openingQty     Int        @default(0)
  // Running balances. Only changed inside approval transactions (see lib/workflow.ts).
  receivedQty    Int        @default(0)
  distributedQty Int        @default(0)
  availableQty   Int        @default(0)
  status         ItemStatus @default(DRAFT)
  deletedAt      DateTime?
  createdById    String
  createdBy      User       @relation("ItemCreator", fields: [createdById], references: [id])
  requestId      String? // the STOCK_MASTER request that introduced this item
  request        Request?   @relation("MasterItems", fields: [requestId], references: [id])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  receiptLines      ReceiptLine[]
  distributionLines DistributionLine[]
  ledger            LedgerEntry[]

  @@index([status])
  @@index([product])
}

model Request {
  id            String        @id @default(cuid())
  number        String        @unique // MI-DST-2026-000123
  type          RequestType
  status        RequestStatus @default(DRAFT)
  title         String
  purpose       String?
  remarks       String?
  currentLevel  Int           @default(0) // levels already approved
  requiredLevel Int           @default(1) // snapshot of the configured levels at submission
  createdById   String
  createdBy     User          @relation("RequestCreator", fields: [createdById], references: [id])
  submittedAt   DateTime?
  decidedAt     DateTime?
  totalQty      Int           @default(0)
  lineCount     Int           @default(0)
  uploadBatchId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  masterItems       StockItem[]        @relation("MasterItems")
  receiptLines      ReceiptLine[]
  distributionLines DistributionLine[]
  events            ApprovalEvent[]
  ledger            LedgerEntry[]

  @@index([status, type])
  @@index([createdById])
}

model DistributionLine {
  id            String    @id @default(cuid())
  requestId     String
  request       Request   @relation(fields: [requestId], references: [id], onDelete: Restrict)
  stockItemId   String
  stockItem     StockItem @relation(fields: [stockItemId], references: [id])
  quantity      Int
  distributedOn DateTime
  recipientId   String? // employee id
  recipientName String
  location      String?
  purpose       String? // Onboarding, Event - Design-a-thon, Mavericks Week, ...
  poc           String?
  remarks       String?
  createdAt     DateTime  @default(now())

  @@index([stockItemId])
  @@index([requestId])
  @@index([recipientId])
}

model ReceiptLine {
  id          String    @id @default(cuid())
  requestId   String
  request     Request   @relation(fields: [requestId], references: [id], onDelete: Restrict)
  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id])
  quantity    Int
  receivedOn  DateTime
  remarks     String?
  createdAt   DateTime  @default(now())

  @@index([stockItemId])
}

/// Immutable approval history — rows are only ever inserted.
model ApprovalEvent {
  id        String         @id @default(cuid())
  requestId String
  request   Request        @relation(fields: [requestId], references: [id])
  action    ApprovalAction
  level     Int            @default(0)
  actorId   String
  actor     User           @relation(fields: [actorId], references: [id])
  remarks   String?
  createdAt DateTime       @default(now())

  @@index([requestId])
}

/// Stock movement ledger — rows are only ever inserted.
model LedgerEntry {
  id           String     @id @default(cuid())
  stockItemId  String
  stockItem    StockItem  @relation(fields: [stockItemId], references: [id])
  requestId    String?
  request      Request?   @relation(fields: [requestId], references: [id])
  type         LedgerType
  qtyIn        Int        @default(0)
  qtyOut       Int        @default(0)
  balanceAfter Int
  note         String?
  actorId      String
  actor        User       @relation(fields: [actorId], references: [id])
  createdAt    DateTime   @default(now())

  @@index([stockItemId, createdAt])
}

/// Data change log for every write in the system.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String // e.g. STOCK_ITEM.UPDATE
  entity    String
  entityId  String?
  summary   String
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model UploadBatch {
  id         String   @id @default(cuid())
  kind       String // STOCK_MASTER | DISTRIBUTION | RECEIPT
  fileName   String
  totalRows  Int
  validRows  Int
  errorRows  Int
  errors     Json? // [{row, field, message}]
  createdBy  String
  user       User     @relation(fields: [createdBy], references: [id])
  createdAt  DateTime @default(now())
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model Counter {
  key   String @id
  value Int    @default(0)
}
