# ---- Database (PostgreSQL 14+) ----
# Vercel + Neon:  DATABASE_URL = pooled connection string, DIRECT_URL = direct (non-pooled) string
# AWS RDS / Azure Database for PostgreSQL: use the same URL for both, with ?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/mavericks?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/mavericks?sslmode=require"

# ---- Auth ----
# 32+ random characters. Generate with:  openssl rand -base64 48
AUTH_SECRET=""

# ---- Demo ----
# "true" shows the demo accounts on the sign-in page. Set to "false" in production.
DEMO_MODE="false"
# Password given to the seeded demo users (npm run db:seed)
SEED_PASSWORD="Mavericks@2026"

# ---- First administrator (production) ----
# While the database has no user accounts, signing in with these creates the first
# System Administrator, who must then choose a new password. They stop working once any account exists.
BOOTSTRAP_ADMIN_EMAIL="admin@yourcompany.com"
BOOTSTRAP_ADMIN_PASSWORD="change-me-to-a-long-password"

# ---- Company single sign-on (optional; off unless the first three are set) ----
# See docs/SETUP-AND-DEPLOYMENT.md section 13. For Microsoft Entra ID:
# SSO_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"
# SSO_CLIENT_ID="<application-client-id>"
# SSO_CLIENT_SECRET="<client-secret-value>"
# SSO_PROVIDER_NAME="Microsoft"
# APP_URL="https://your-app-address"
# SSO_ALLOWED_EMAIL_DOMAINS="hexaware.com"
# SSO_ONLY="false"

# ---- Vercel only ----
# "true" makes the Vercel build load demo data into an empty database.
# SEED_DEMO_DATA="true"
